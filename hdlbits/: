module top_module (
    input  [31:0] a,
    b,
    output [31:0] sum
);
  wire [15:0] sum1, sum2, a1, a2, b1, b2;
  wire inter, dump;
  assign {a1, a2} = a;
  assign {b1, b2} = b;

  add16 low_half (
      .a(a1),
      .b(b1),
      .cin(0),
      .cout(inter),
      .sum(sum1)
  );
  add16 higher_half (
      .a(a2),
      .b(b2),
      .cin(inter),
      .cout(dump),
      .sum(sum2)
  );

  assign sum = {sum1, sum2, dump};

endmodule
